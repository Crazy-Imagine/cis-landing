---
import type { Background } from '@/types/Background';

interface Props {
  containerClass?: string;
  class?: string;
  background?: Background;
  is404?: boolean;
  /**
   * Si es true, el `<section>` deja de ser `relative`, de modo que los hijos `absolute`
   * usan como bloque contenedor el div exterior (útil con alturas fijas y `top` en %).
   */
  outerAbsoluteBounds?: boolean;
}

const backgroundClasses: {
  [key: string]: string;
} = {
  white: 'bg-fog-white',
  blue: 'bg-primary',
  bulbs: 'bg-primary bg-light-bulbs bg-center bg-repeat',
  blueNew: 'bg-primary-blue',
  contactUs: 'bg-contact-us bg-cover bg-center bg-no-repeat',
  blog: 'bg-blog-hero bg-cover bg-center bg-no-repeat',
};

const actualBackground = backgroundClasses[Astro.props.background ?? 'white'];
---

<div
  class:list={[
    'relative py-10 md:py-20',
    actualBackground,
    Astro.props.containerClass,
    {
      'bg-404': Astro.props.is404,
    },
  ]}
>
  <slot name="image" />
  {
    Astro.props?.background === 'bulbs' && (
      <div class="absolute inset-0 z-10 bg-gradient-to-r from-primary-with-transparency to-transparent" />
    )
  }
  {Astro.props?.background === 'blog' && <div class="absolute inset-0 z-10 bg-[#131E29]/50" />}

  <section
    class:list={[
      'container mx-auto px-4 md:px-5 lg:px-10 min-[1546px]:px-0',
      Astro.props.outerAbsoluteBounds ? 'static' : 'relative z-20',
      Astro.props.class,
    ]}
  >
    <slot />
  </section>
</div>

<style>
  .bg-404 {
    background-image: linear-gradient(
        123deg,
        rgba(40, 64, 128, 1) 0%,
        rgba(39, 170, 225, 1) 31%,
        transparent 75%
      ),
      url('/img/backgrounds/404.svg');
    background-size: cover;
    background-position: top;
  }
</style>
