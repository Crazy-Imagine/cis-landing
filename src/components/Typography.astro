---
import type { HTMLTag, Polymorphic } from 'astro/types';

type Props<Tag extends HTMLTag> = Polymorphic<{
  as: Tag;
  variant: keyof typeof variantClasses;
  isNew?: boolean;
}>;

const { as: Tag, class: className, variant, isNew, ...props } = Astro.props;

const variantClasses: {
  [key: string]: string;
} = {
  h1: 'font-colvetica text-2xl leading-7 sm:text-5xl sm:leading-10 xl:text-[80px] xl:leading-[80px]',
  h2: `font-colvetica text-2xl leading-5 sm:text-4xl sm:leading-10 ${isNew ? 'lg:text-[88px] xl:leading-[80px]' : 'lg:text-6xl'}`,
  h3: 'font-colvetica text-2xl sm:text-4xl lg:text-[40px]',
  h4: 'font-colvetica lg:text-3xl',
  h5: 'font-colvetica lg:text-2xl',
  h6: 'font-colvetica text-xs tracking-widest lg:text-sm',
  link: `${isNew ? 'text-primary-blue' : 'text-white'} font-colvetica uppercase tracking-wide`,
  accent: 'font-colvetica text-base',
  caption: 'font-colvetica lg:text-xl',
  paragraph: 'font-roboto lg:text-xl',
  paragraph2: 'font-roboto lg:text-base',
  paragraph3: 'font-roboto text-[14px]',
  blogTitle:
    'font-nexaBold text-2xl leading-7 sm:text-5xl sm:leading-10 lg:text-[70px] lg:leading-[80px]',
};

const classes = [variantClasses[variant as keyof typeof variantClasses], className];
---

<Tag class:list={classes} {...props}>
  <slot />
</Tag>
