---
import { Image } from 'astro:assets';
import CardCTA from './CardCTA.astro';
import Typography from './Typography.astro';
import { getImageUrl } from '@/utils/imageUrl';
import { getLangFromUrl, useTranslatedPath } from '@/i18n/utils';

interface Props {
  altText?: string;
  ariaLabel?: string;
  class?: string;
  height: number;
  href: string;
  img: string;
  isSwiperCard?: boolean;
  linkText: string;
  projectType?: string;
  title: string;
  width: number;
  cardBg?: string;
  isNew?: boolean;
  description?: string;
}

const {
  altText = '',
  ariaLabel = '',
  height,
  href,
  img,
  isSwiperCard = true,
  linkText,
  projectType,
  title,
  width,
  cardBg,
  isNew,
  description,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
---

<article
  class:list={[
    'my-2 !flex !h-auto flex-col rounded-xl',
    Astro.props.class,
    {
      'swiper-slide': isSwiperCard,
    },
    cardBg ?? 'bg-white',
  ]}
  {...projectType ? { 'data-project-type': projectType } : {}}
>
  <picture class:list={['rounded-xl', { 'p-4': isNew }]}>
    <Image
      transition:animate="slide"
      transition:name={`${title}-image`}
      class="h-auto w-full rounded-xl object-cover"
      src={getImageUrl(img)}
      alt={altText}
      width={width}
      height={height}
    />
    {isSwiperCard && <div class="swiper-lazy-preloader" />}
  </picture>

  <div class="mt-auto p-5 text-center">
    <Typography
      transition:name={`${title}-title`}
      class:list={[
        'line-clamp-2',
        {
          'text-primary': !isNew,
          'bg-gradinet-font bg-clip-text text-start text-transparent': isNew,
        },
      ]}
      as="p"
      variant="accent"
    >
      {title}
    </Typography>

    {
      description && (
        <Typography class="text-start text-white" as="p" variant="paragraph3">
          {description}
        </Typography>
      )
    }

    <CardCTA
      isNew={isNew}
      class="mt-2.5 !justify-self-start"
      href={translatePath(href, lang)}
      text={linkText}
      ariaLabel={ariaLabel}
    />
  </div>
</article>
