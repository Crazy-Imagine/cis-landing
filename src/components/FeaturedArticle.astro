---
import { Image } from 'astro:assets';
import CardCTA from './CardCTA.astro';
import Typography from './Typography.astro';
import { getImageUrl } from '@/utils/imageUrl';
import { getLangFromUrl, useTranslatedPath, useTranslations } from '@/i18n/utils';
import { formatPublishedAt } from '@/utils/formateDate';

interface Props {
  altText?: string;
  ariaLabel?: string;
  class?: string;
  height: number;
  href: string;
  img: string;
  isSwiperCard?: boolean;
  linkText: string;
  projectType?: string;
  title: string;
  width: number;
  cardBg?: string;
  isNew?: boolean;
  description?: string;
  publishedAt: string;
}

const {
  altText = '',
  ariaLabel = '',
  height,
  href,
  img,
  isSwiperCard = true,
  linkText,
  projectType,
  title,
  width,
  cardBg,
  isNew,
  publishedAt,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const publishedAtLabel = formatPublishedAt(publishedAt, lang);
---

<article
  style="background-color: rgba(226, 229, 232, 0.08);"
  class:list={[
    '!flex !h-auto w-full max-w-[770px] flex-col rounded-md p-6 text-start lg:px-14 lg:py-10',
    Astro.props.class,
    {
      'swiper-slide': isSwiperCard,
    },
    cardBg ?? 'bg-gray-with-transparency backdrop-blur-sm',
  ]}
  {...projectType ? { 'data-project-type': projectType } : {}}
>
  <picture class="mx-auto block w-full max-w-[560px]">
    <Image
      transition:animate="slide"
      transition:name={`${title}-image`}
      class="aspect-[2/1] h-auto w-full rounded-sm object-cover"
      src={getImageUrl(img)}
      alt={altText}
      width={width}
      height={height}
    />
  </picture>

  <div class="mt-6 flex flex-col gap-4">
    <div class="flex items-center gap-4">
      <Typography
        style={'background-color: #C0FF0033;'}
        as="p"
        variant="paragraph3"
        class={'px-4 py-1  rounded-lg text-primary-new '}>{t('common.recent')}</Typography
      >
      <Typography as="p" variant="paragraph3" class={'text-[#94A3B8]'}
        >{publishedAtLabel}</Typography
      >
    </div>
    <Typography
      transition:name={`${title}-title`}
      class:list={[
        'line-clamp-2 font-bold',
        {
          'text-white': !isNew,
          'text-start text-primary-blue': isNew,
        },
      ]}
      as="p"
      variant="h5"
    >
      {title}
    </Typography>

    <CardCTA
      isNew
      align="center"
      linkColor="text-primary-new"
      class="mt-2 font-bold"
      href={translatePath(href, lang)}
      text={linkText}
      ariaLabel={ariaLabel}
      textColor="text-primary-new"
    />
  </div>
</article>
