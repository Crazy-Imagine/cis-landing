---
import Typography from './Typography.astro';

interface Props {
  href: string;
  class?: string;
  variant: keyof typeof variantClasses;
  isNew?: boolean;
}

const { class: className, variant, href, isNew, ...props } = Astro.props;

const variantClasses: {
  [key: string]: string;
} = {
  outlined:
    'border-2 font-roboto text-xs uppercase text-white transition hover:bg-white hover:text-primary',
  contained: `${isNew ? 'bg-primary-new font-bold text-primary-blue' : 'bg-blue-purple hover:bg-blue-purple-contrast'} transition hover:cursor-pointer `,
};

const classes = [
  'inline-block rounded-full px-6 py-2.5',
  variantClasses[variant as keyof typeof variantClasses],
  className,
];
---

<Typography isNew={isNew} as="a" variant="link" href={href} class:list={classes} {...props}>
  <slot />
</Typography>
