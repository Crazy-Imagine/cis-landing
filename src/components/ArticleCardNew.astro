---
import { Image } from 'astro:assets';
import Typography from './Typography.astro';
import { getImageUrl } from '@/utils/imageUrl';
import { getLangFromUrl, useTranslatedPath } from '@/i18n/utils';

interface Props {
  altText?: string;
  ariaLabel?: string;
  class?: string;
  height: number;
  href: string;
  img: string;
  isSwiperCard?: boolean;
  linkText?: string;
  projectType?: string;
  title: string;
  width: number;
  description?: string;
  linkClass?: string;
}

const {
  altText = '',
  height,
  href,
  img,
  isSwiperCard = true,
  linkText,
  linkClass,
  projectType,
  title,
  width,
  description,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
---

<article
  data-href={href}
  class:list={[
    'my-2 !flex !h-auto cursor-pointer flex-col rounded-xl border border-transparent bg-white shadow-md hover:shadow-primary-new-with-transparency',
    Astro.props.class,
    {
      'swiper-slide': isSwiperCard,
    },
  ]}
  {...projectType ? { 'data-project-type': projectType } : {}}
>
  <picture class="relative block h-[250px] overflow-hidden rounded-t-xl">
    <Image
      transition:animate="slide"
      transition:name={`${title}-image`}
      class="h-full w-full rounded-t-xl object-cover"
      src={getImageUrl(img)}
      alt={altText}
      width={width}
      height={height}
      quality={100}
    />
    <!-- {isSwiperCard && <div class="swiper-lazy-preloader" />} -->
  </picture>

  <div class="mt-auto flex flex-col gap-3 p-6">
    <Typography
      isNew
      class={`text-primary-blue w-[65%] text-start font-bold capitalize`}
      as="p"
      variant="paragraph3"
    >
      {projectType}
    </Typography>
    <Typography
      transition:name={`${title}-title`}
      class="line-clamp-2 font-bold text-primary-blue"
      as="p"
      variant="paragraph"
    >
      {title}
    </Typography>
    <Typography
      transition:name={`${title}-title`}
      class="line-clamp-2 text-font-light-gray"
      as="p"
      variant="paragraph3"
    >
      {description}
    </Typography>
    {
      linkClass && (
        <Typography class={linkClass} as="p" variant="paragraph3">
          {linkText}
        </Typography>
      )
    }
  </div>
</article>

<script>
  function navigateArticleCard(event: MouseEvent) {
    const target = event.target as Element | null;
    const card = target?.closest?.('article[data-href]');
    if (!card) return;
    const href = card.getAttribute('data-href');
    if (href) window.location.href = href;
  }

  document.addEventListener('click', navigateArticleCard);
</script>
