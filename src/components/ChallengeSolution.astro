---
import ResponsiveContainer from './ResponsiveContainer.astro';
import Typography from './Typography.astro';
import challengeIcon from '@/assets/ui/challenge-icon.png';
import solutionIcon from '@/assets/ui/solution-icon.png';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

interface Props {
  solution: string;
  challenge: string;
}

const { solution, challenge } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<ResponsiveContainer background="white" containerClass="!pb-10">
  <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-8">
    {
      [
        {
          key: 'challenge',
          label: t('common.challenge'),
          icon: challengeIcon,
          html: challenge,
        },
        {
          key: 'solution',
          label: t('common.solution'),
          icon: solutionIcon,
          html: solution,
        },
      ].map((block) => (
        <div class="flex flex-col gap-4 rounded-md bg-gray-new p-8 shadow-md">
          <div class="flex items-center gap-3">
            {/* Ícono sin fondo usado como máscara: toma el color de la marca. */}
            <span
              aria-hidden="true"
              class="block h-8 w-8 bg-primary-blue"
              style={`mask: url('${block.icon.src}') center / contain no-repeat; -webkit-mask: url('${block.icon.src}') center / contain no-repeat;`}
            />
            <Typography as="h2" variant="h5" class="font-bold text-primary-blue">
              {block.label}
            </Typography>
          </div>
          <div
            class="font-roboto text-base text-primary-blue [&_p]:text-primary-blue"
            set:html={block.html}
          />
        </div>
      ))
    }
  </div>
</ResponsiveContainer>
