---
import LinkPill from './LinkPill.astro';
import ResponsiveContainer from './ResponsiveContainer.astro';
import Typography from './Typography.astro';

interface Props {
  title: string;
  caption?: string;
  subtitle: string;
  href: string;
  buttonText: string;
  isCard?: boolean;
}

const { title, caption, subtitle, href, buttonText, isCard = false } = Astro.props;
---

<ResponsiveContainer
  background={isCard ? 'white' : 'blueNew'}
  containerClass={`flex justify-center items-center ${isCard ? '!pt-10' : ''}`}
>
  <div
    class:list={[
      'flex w-full flex-col justify-center justify-self-center',
      isCard
        ? 'gap-4 rounded-[40px] bg-primary-blue p-10 lg:w-[90%] lg:px-20 lg:py-16'
        : 'items-center gap-6 lg:w-[70%]',
    ]}
  >
    <Typography
      as="h2"
      variant="h1"
      class:list={['text-white lg:!text-5xl', isCard ? 'text-left' : 'max-w-[640px] text-center']}
    >
      {title}
    </Typography>
    {
      caption && (
        <Typography as="p" variant="paragraph3" class="text-center text-primary-new">
          {caption}
        </Typography>
      )
    }
    <Typography
      as="p"
      variant="paragraph"
      class:list={['text-sm text-white', isCard ? 'text-left lg:!text-base' : 'text-center']}
    >
      {subtitle}
    </Typography>
    <LinkPill
      isNew
      href={href}
      variant="contained"
      class:list={[
        isCard
          ? 'mt-6 w-full max-w-[500px] self-center !rounded-md !py-4 text-center text-lg !normal-case !tracking-normal'
          : 'cta-section-breathing-neon mt-4 !rounded-md !px-8 !py-3 text-base !normal-case !tracking-normal',
      ]}
    >
      {buttonText}
    </LinkPill>
  </div>
</ResponsiveContainer>

<style>
  :global(.cta-section-breathing-neon) {
    animation: cta-section-breathe-glow 2.75s ease-in-out infinite;
  }

  @keyframes cta-section-breathe-glow {
    0%,
    100% {
      box-shadow:
        0 0 10px 2px rgba(177, 214, 0, 0.55),
        0 0 28px 6px rgba(177, 214, 0, 0.22);
      transform: scale(1);
    }

    50% {
      box-shadow:
        0 0 22px 7px rgba(177, 214, 0, 0.78),
        0 0 52px 14px rgba(177, 214, 0, 0.38);
      transform: scale(1.02);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.cta-section-breathing-neon) {
      animation: none;
      box-shadow: 0 0 16px 4px rgba(177, 214, 0, 0.45);
      transform: none;
    }
  }
</style>
