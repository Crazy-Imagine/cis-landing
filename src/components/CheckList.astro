---
import Typography from './Typography.astro';

/** Lista con el check verde del rediseño (como en la política de privacidad). */
interface Props {
  items: string[];
  tone?: 'light' | 'dark';
  class?: string;
}

const { items, tone = 'light', class: className } = Astro.props;
---

<ul class:list={['flex flex-col gap-4', className]}>
  {
    items.map((item) => (
      <li class="flex items-start gap-3">
        <span
          aria-hidden="true"
          class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary-new font-roboto text-xs font-bold text-primary-blue"
        >
          ✓
        </span>
        <Typography
          as="span"
          variant="paragraph2"
          class:list={[tone === 'dark' ? 'text-white' : 'text-primary-blue']}
        >
          {item}
        </Typography>
      </li>
    ))
  }
</ul>
