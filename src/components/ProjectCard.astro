---
import { Image } from 'astro:assets';
import LinkPill from './LinkPill.astro';
import Typography from './Typography.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import { getImageUrl } from '@/utils/imageUrl';

interface Props {
  title: string;
  description: string;
  image: string;
  link: string;
  width: number;
  height: number;
}

const { title, description, image, link, width, height } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<article
  class="flex w-[80%] flex-col-reverse items-center gap-10 place-self-center px-10 py-8 lg:flex-row"
>
  <div class="flex flex-1 shrink-0 basis-2/5 flex-col gap-4">
    <Typography as="h3" variant="h3" class="text-2xl font-bold text-black">{title}</Typography>
    <Typography as="p" variant="paragraph" class="text-base font-semibold text-black"
      >{description}</Typography
    >

    <LinkPill isNew variant="contained" href={link} class="custom-w-button rounded-md">
      {t('common.view-project')}
    </LinkPill>
  </div>

  <div class="flex flex-1 basis-3/5 justify-end">
    <Image
      transition:name={`${title}-image`}
      class="h-auto w-full max-w-[520px] rounded-md object-cover"
      src={getImageUrl(image)}
      alt={title}
      width={width}
      height={height}
      loading="lazy"
    />
  </div>
</article>
