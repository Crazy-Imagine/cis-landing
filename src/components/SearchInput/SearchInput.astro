---
import { getLangFromUrl, useTranslatedPath, useTranslations } from '@/i18n/utils';

interface Props {
  defaultValue: string;
}

const { defaultValue } = Astro.props as Props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<div class="my-5 w-full">
  <input
    placeholder=`${t('common.search')}`
    id="search-input"
    type="search"
    aria-label={t('common.search')}
    data-results-path={translatePath('/blog/all')}
    class="focus:outline-solid w-full rounded-lg border border-[#E6E6E6] px-[26px] py-[15px] focus-visible:outline-[#d1d5db]"
    value={defaultValue}
  />
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const inputSearch = document.getElementById('search-input');
    if (!inputSearch) return;
    let inputValue: NodeJS.Timeout;
    inputSearch?.addEventListener('input', (event) => {
      if (!event.target) return;
      const value = (event.target as any).value;
      if (inputValue) {
        clearTimeout(inputValue);
      }
      const resultsPath = inputSearch.dataset.resultsPath || '/blog/all';
      inputValue = setTimeout(() => {
        location.href = value.trim()
          ? `${resultsPath}?search=${encodeURIComponent(value.trim())}#articles`
          : `${resultsPath}#articles`;
      }, 1000);
    });
  });
</script>
