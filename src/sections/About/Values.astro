---
import ResponsiveContainer from '@/components/ResponsiveContainer.astro';
import Typography from '@/components/Typography.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import type { Values } from '@/types/strapi/PageInfo';

interface Props {
  values: Values[];
}

const { values } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<ResponsiveContainer background="blueNew">
  <div class="mb-10 flex flex-col items-center">
    <Typography isNew as="h2" variant="h2" class="text-center text-white">
      {t('common.our-values')}
    </Typography>
    <span class="mt-3 block h-1 w-32 shrink-0 rounded-full bg-[#AC4FC6]" aria-hidden="true"></span>
  </div>

  <div class="mx-auto flex max-w-[1000px] flex-wrap justify-center gap-4 sm:gap-5">
    {
      values.map((value) => (
        <Typography
          as="p"
          variant="paragraph2"
          class="rounded-md bg-white px-10 py-4 text-center font-bold text-primary-blue sm:px-14 lg:!text-lg"
        >
          {value.value}
        </Typography>
      ))
    }
  </div>
</ResponsiveContainer>
