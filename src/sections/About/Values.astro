---
import ResponsiveContainer from '@/components/ResponsiveContainer.astro';
import Typography from '@/components/Typography.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import type { Values } from '@/types/strapi/PageInfo';

interface Props {
  values: Values[];
}

const { values } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<ResponsiveContainer background="blueNew">
  <div class="mb-10 flex flex-col items-center">
    <Typography isNew as="h2" variant="h2" class="text-center text-white">
      {t('common.our-values')}
    </Typography>
    <span class="mt-3 inline-block h-1 w-32 shrink-0 rounded-full bg-[#AC4FC6]" aria-hidden="true"
    ></span>
  </div>

  <div class="flex flex-wrap justify-center gap-4 sm:gap-5">
    {
      values.map((value) => (
        <Typography
          as="p"
          variant="paragraph"
          class="mx-auto box-border w-full max-w-md shrink-0 rounded-2xl bg-white px-6 py-4 text-center font-bold text-primary-blue sm:mx-0 sm:w-[calc((100%-1.25rem)/2)] sm:max-w-none sm:px-8 sm:py-5 md:w-[calc((100%-2.5rem)/3)] lg:w-[calc((100%-3.75rem)/4)]"
        >
          {value.value}
        </Typography>
      ))
    }
  </div>
</ResponsiveContainer>
