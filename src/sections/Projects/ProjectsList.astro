---
import ResponsiveContainer from '@/components/ResponsiveContainer.astro';
import fetchApi from '@/lib/strapi';
import type { ProjectCollection } from '@/types/strapi/Project';
import { getLangFromUrl, useTranslatedPath, useTranslations } from '@/i18n/utils';
import Typography from '@/components/Typography.astro';
import ArticleCardNew from '@/components/ArticleCardNew.astro';
import ProjectLogoCard from '@/components/ProjectLogoCard.astro';

interface Props {
  title?: string;
  /** `logos`: card con captura + logo del cliente (home). `default`: card con tipo, título y descripción. */
  variant?: 'default' | 'logos';
  limit?: number;
}

const { title, variant = 'default', limit } = Astro.props;
const isLogos = variant === 'logos';

const projects = await fetchApi<ProjectCollection>({
  endpoint: 'projects',
  params: {
    locale: Astro.currentLocale,
    fields: ['title', 'description', 'details', 'slug'],
    publicationState: 'live',
    populate: {
      project_types: {
        fields: ['name', 'slug'],
      },
      images: {
        fields: ['url', 'formats', 'width', 'height'],
      },
      ...(isLogos && {
        logo: {
          fields: ['url', 'alternativeText'],
        },
      }),
    },
    filters: {
      title: {
        $notNull: true,
      },
    },
    sort: {
      createdAt: 'desc',
    },
    ...(limit && { pagination: { limit } }),
  },
});

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<ResponsiveContainer>
  <Typography
    isNew
    class:list={[
      'w-[75%] text-start font-bold text-primary-blue',
      isLogos ? 'mb-12 lg:mb-20' : 'mb-10',
    ]}
    as="h2"
    variant="h2"
  >
    {title ?? t('common.projects-title')}
  </Typography>
  <div
    id="projects-container"
    class:list={[
      'grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3',
      isLogos ? 'gap-6 lg:gap-10 xl:-mx-16 2xl:-mx-24' : 'gap-5 px-10 lg:gap-10 2xl:px-20',
    ]}
  >
    {
      projects.data.map(
        ({
          attributes: {
            images: {
              data: [image],
            },
            logo,
            ...project
          },
        }) =>
          isLogos ? (
            <ProjectLogoCard
              title={project.title}
              ariaLabel={`${t('aria.link-to-project-page')}: "${project.title}"`}
              href={translatePath(`/projects/${project.slug}`)}
              img={image.attributes.formats.medium.url}
              width={image.attributes.formats.medium.width}
              height={image.attributes.formats.medium.height}
              logo={logo?.data?.attributes}
              projectType={project.project_types.data[0]?.attributes.slug}
            />
          ) : (
            <ArticleCardNew
              projectType={project.project_types.data[0].attributes.slug}
              altText={project.title}
              description={project.description}
              ariaLabel={`${t('aria.link-to-project-page')}: "${project.title}"`}
              class="shadow-xl"
              height={image.attributes.formats.medium.height}
              href={translatePath(`/projects/${project.slug}`)}
              img={image.attributes.formats.medium.url}
              linkText={t('common.view-project')}
              title={project.title}
              width={image.attributes.formats.medium.width}
            />
          )
      )
    }
  </div>
</ResponsiveContainer>

<script>
  import { projectTypeSelected } from '@/store/projectsStore';

  const $projectsContainer = document.getElementById('projects-container');

  if ($projectsContainer) {
    projectTypeSelected.subscribe((value) => {
      $projectsContainer.querySelectorAll('[data-project-type]').forEach(($element: any) => {
        if (value === 'all' || $element.dataset.projectType === value) {
          $element.classList.remove('!hidden');
        } else {
          $element.classList.add('!hidden');
        }
      });
    });
  }
</script>
