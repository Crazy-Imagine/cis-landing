---
import { Image } from 'astro:assets';
import ResponsiveContainer from '@/components/ResponsiveContainer.astro';
import Typography from '@/components/Typography.astro';
import { getLangFromUrl, useTranslatedPath, useTranslations } from '@/i18n/utils';
import fetchApi from '@/lib/strapi';
import type { Project, ProjectCollection } from '@/types/strapi/Project';
import { stripHighlight } from '@/utils/highlight';
import { getImageUrl } from '@/utils/imageUrl';

/**
 * "Impulsando a otros líderes del sector": hasta 3 proyectos de la misma categoría que el actual;
 * si no alcanzan, se completa con los más recientes de otras categorías.
 */
interface Props {
  projectId: number;
  categoryId?: number;
}

const { projectId, categoryId } = Astro.props;
const limit = 3;

function fetchProjects(filters: Record<string, unknown>, max: number) {
  return fetchApi<ProjectCollection>({
    endpoint: 'projects',
    params: {
      locale: Astro.currentLocale,
      fields: ['title', 'description', 'slug'],
      publicationState: 'live',
      populate: {
        images: {
          fields: ['url', 'formats', 'width', 'height'],
        },
      },
      filters: {
        title: { $notNull: true },
        ...filters,
      },
      pagination: { limit: max },
      sort: { createdAt: 'desc' },
    },
  });
}

const sameCategory: Project[] = categoryId
  ? (
      await fetchProjects(
        { id: { $ne: projectId }, project_types: { id: { $eq: categoryId } } },
        limit
      )
    ).data
  : [];

const projects =
  sameCategory.length < limit
    ? [
        ...sameCategory,
        ...(
          await fetchProjects(
            { id: { $notIn: [projectId, ...sameCategory.map((project) => project.id)] } },
            limit - sameCategory.length
          )
        ).data,
      ]
    : sameCategory;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

{
  projects.length > 0 && (
    <ResponsiveContainer background="white">
      <div class="mb-10 flex flex-col gap-6 lg:mb-14 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-[640px]">
          <Typography as="h2" variant="h2" class="font-bold text-primary-blue">
            {t('common.other-projects-title')}
          </Typography>
          <Typography as="p" variant="paragraph2" class="mt-3 text-primary-blue">
            {t('common.other-projects-description')}
          </Typography>
        </div>
        <a
          href={translatePath('/projects')}
          class="flex shrink-0 items-center gap-2 font-roboto text-base font-bold text-primary-blue hover:underline"
        >
          {t('common.explore-other-projects')}
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {projects.map(({ attributes: { images, ...project } }) => {
          const image = images.data[0]?.attributes;
          const title = stripHighlight(project.title);

          return (
            <a
              href={translatePath(`/projects/${project.slug}`)}
              aria-label={`${t('aria.link-to-project-page')}: "${title}"`}
              class="group flex flex-col gap-4 rounded-lg bg-primary-blue p-4 shadow-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary-blue"
            >
              <div class="aspect-[16/9] overflow-hidden rounded-md bg-white">
                {image && (
                  <Image
                    class="h-full w-full object-cover object-top"
                    src={getImageUrl(image.formats.small?.url ?? image.url)}
                    alt=""
                    width={image.formats.small?.width ?? image.width}
                    height={image.formats.small?.height ?? image.height}
                    loading="lazy"
                  />
                )}
              </div>
              <div class="flex flex-1 flex-col gap-2 px-1 pb-1">
                <Typography as="h3" variant="paragraph2" class="font-bold text-white">
                  {project.title}
                </Typography>
                <Typography as="p" variant="paragraph3" class="line-clamp-2 text-[#cbd5e1]">
                  {project.description}
                </Typography>
                <span class="mt-auto pt-2 font-roboto text-sm font-bold text-primary-new">
                  {t('common.view-project')}{' '}
                  <span
                    aria-hidden="true"
                    class="inline-block transition-transform group-hover:translate-x-1"
                  >
                    →
                  </span>
                </span>
              </div>
            </a>
          );
        })}
      </div>
    </ResponsiveContainer>
  )
}
