---
import { Image } from 'astro:assets';
import Clutch from '@/icons/Clutch.astro';
import { getImageUrl } from '@/utils/imageUrl';
import Typography from '@/components/Typography.astro';
import type { CustomHero } from '@/types/strapi/Hero';
import { getLangFromUrl } from '@/i18n/utils';

interface Props extends CustomHero {
  isNew?: boolean;
  sectionClass?: string;
  hiddenClutch?: boolean;
  isCustom?: boolean;
  lighten?: boolean;
  types?: string[];
  customImageClass?: string;
  customTextClass?: string;
  customHeight?: string;
}

const {
  title,
  subtitle,
  image,
  isNew,
  backgroundImage,
  sectionClass,
  hiddenClutch,
  isCustom,
  lighten,
  types,
  customImageClass,
  customTextClass,
  customHeight,
} = Astro.props;
const lang = getLangFromUrl(Astro.url);
const heroImage = backgroundImage?.data?.attributes
  ? backgroundImage?.data?.attributes
  : image?.data?.attributes;

const images = import.meta.glob('/src/assets/landing/*.webp') as any;

const titleTypographyClass = isNew
  ? ' font-bold capitalize  bg-gradinet-font bg-clip-text text-transparent first-line:text-white w-full md:w-[90%]'
  : 'font-bold capitalize';
---

<section
  class:list={[
    'second relative -mt-[var(--header-height)] h-fit w-full overflow-hidden bg-secondary bg-cover bg-center bg-no-repeat p-4 pt-[var(--header-height)] text-white md:px-5 lg:px-10 lg:pb-[var(--header-height)] min-[1546px]:px-0',
    !customHeight && title.length > 80 && title.length < 110
      ? 'xl:h-[650px]'
      : title.length > 110
        ? 'xl:h-[780px]'
        : 'xl:h-[550px]',
    customHeight,
    {
      'bg-hero-background ': isNew,
      'md:bg-hero': !isNew,
    },
    sectionClass,
  ]}
>
  {
    !isNew && (
      <div class="absolute inset-0 z-10 bg-gradient-to-b from-transparent to-primary md:to-primary-with-transparency" />
    )
  }

  <div
    class:list={[
      'container z-10 mx-auto hidden h-full w-full items-center rounded-xl sm:flex lg:gap-10',
      {
        'sm:bg-secondary': !isNew,
        'px-4 md:px-5 lg:px-10 min-[1546px]:px-0': isNew,
        'sm:bg-secondary-with-transparency': backgroundImage?.data,
        // 'relative': !backgroundImage?.data,
      },
    ]}
  >
    <div
      class:list={[
        'z-10  gap-4',
        {
          'sm:pl-8 lg:pl-14 xl:pl-[100px]': !isNew,
          'w-[75%]': isCustom && heroImage?.url,
          '!w-full': backgroundImage?.data?.attributes,
          'w-[85%]': !heroImage?.url,
          'w-[70%]': !isCustom,
        },
        customTextClass,
      ]}
    >
      {isNew && !hiddenClutch && <Clutch fill="#BFED06" />}

      <Typography class={`${titleTypographyClass} whitespace-pre-line`} as="h1" variant="h1">
        {title}
      </Typography>

      {
        subtitle && (
          <Typography class="my-10 uppercase !text-white" as="p" variant="h6">
            {subtitle}
          </Typography>
        )
      }

      {
        types && (
          <div class:list={['flex flex-wrap gap-5', !subtitle && 'mt-10']}>
            {types.map((type) => (
              <Typography
                class="rounded-lg border border-solid border-primary-with-transparency bg-primary-with-transparency-white px-5 py-2 capitalize !text-white"
                as="p"
                variant="h6"
              >
                {type}
              </Typography>
            ))}
          </div>
        )
      }
      {
        !isNew && (
          <Image
            class="my-5"
            alt="Clutch rating reviews"
            src={images['/src/assets/landing/Clutch.webp']()}
          />
        )
      }

      <slot name="button" />
    </div>

    {
      heroImage && (
        <div
          class:list={[
            {
              'absolute inset-0 right-0 h-full w-full overflow-hidden lg:!right-0':
                backgroundImage?.data,
              'absolute right-0 w-[30%] place-self-end  ': !backgroundImage?.data,
              'absolute bottom-0 lg:right-[2%] 2xl:right-[10%] ': isCustom,
            },
            ' ml-auto flex flex-shrink-0 justify-end place-self-end',
            customImageClass,
          ]}
        >
          <Image
            class:list={[
              {
                'h-full w-full object-cover': backgroundImage?.data,
                'h-auto min-h-[350px] w-full min-w-[350px] lg:min-h-min lg:min-w-[500px] xl:max-h-[550px]':
                  !backgroundImage?.data,
              },
              {
                'opacity-25': backgroundImage?.data,
                'w-[500px]': isCustom,
                'mix-blend-lighten': lighten,
              },
            ]}
            src={getImageUrl(heroImage?.url)}
            width={heroImage?.width}
            height={heroImage?.height}
            alt={heroImage?.alternativeText ?? ''}
            quality={100}
          />
        </div>
      )
    }
  </div>

  <Typography
    class={`relative z-20 sm:hidden whitespace-pre-line ${titleTypographyClass}`}
    as="h1"
    variant="h1"
  >
    {title}
  </Typography>

  {
    subtitle && (
      <Typography class="relative z-20 my-10 uppercase !text-white sm:hidden" as="p" variant="h6">
        {subtitle}
      </Typography>
    )
  }

  <div class="relative z-20 flex items-center sm:hidden">
    <div class="flex flex-shrink-0 flex-grow place-content-center">
      <slot name="button" />
    </div>

    <!-- {
      image && (
        <div class="flex basis-1/2 place-content-end">
          <Image
            class="h-auto w-full max-w-[349px]"
            src={getImageUrl(image.data.attributes.url)}
            width={image.data.attributes.width}
            height={image.data.attributes.height}
            alt={image.data.attributes.alternativeText}
          />
        </div>
      )
    } -->
  </div>
</section>
