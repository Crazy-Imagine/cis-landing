---
import MemberCard from '@/components/react/MemberCard';
import ResponsiveContainer from '@/components/ResponsiveContainer.astro';
import Typography from '@/components/Typography.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import fetchApi from '@/lib/strapi';
import type { MemberCollection } from '@/types/strapi/Member';

const members = await fetchApi<MemberCollection>({
  endpoint: 'members',
  params: {
    locale: Astro.currentLocale,
    // Sin `fields`: así llega `rol` cuando exista en Strapi (pedirlo antes de crearlo da error 400).
    populate: {
      avatar: {
        fields: ['width', 'height', 'url'],
      },
    },
    sort: { createdAt: 'asc' },
  },
});

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<ResponsiveContainer background="white">
  <Typography as="h2" variant="h2" class="font-bold text-primary-blue">
    {t('about.meet-the-team-title')}
  </Typography>
  <Typography as="p" variant="paragraph2" class="mb-12 mt-3 text-primary-blue">
    {t('about.meet-the-team-description')}
  </Typography>

  <div class="flex flex-wrap justify-center gap-10 lg:gap-16">
    {
      members.data.map((member) => (
        <div class="w-full max-w-[290px]">
          <MemberCard member={member} />
        </div>
      ))
    }
  </div>
</ResponsiveContainer>
