---
import MemberCard from '@/components/react/MemberCard';
import ResponsiveContainer from '@/components/ResponsiveContainer.astro';
import Typography from '@/components/Typography.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import fetchApi from '@/lib/strapi';
import type { MemberCollection } from '@/types/strapi/Member';

const members = await fetchApi<MemberCollection>({
  endpoint: 'members',
  params: {
    locale: Astro.currentLocale,
    fields: ['name', 'role', 'cardDescription'],
    populate: {
      avatar: {
        fields: ['width', 'height', 'url'],
      },
    },
    sort: { createdAt: 'asc' },
  },
});

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<ResponsiveContainer background="white">
  <Typography
    isNew
    as="h2"
    variant="h2"
    class="mb-4 bg-gradinet-font bg-clip-text text-center text-transparent"
  >
    {t('about.meet-the-team-title')}
  </Typography>
  <Typography isNew as="p" variant="paragraph" class="mb-10 text-center text-primary-blue">
    {t('about.meet-the-team-description')}
  </Typography>

  <div class="flex flex-wrap justify-center gap-4">
    {
      members.data.map((member) => (
        <div class="w-full sm:w-[calc(50%-0.5rem)] lg:w-[calc(33.333%-0.666rem)] xl:w-[calc(25%-0.75rem)]">
          <MemberCard client:visible member={member} />
        </div>
      ))
    }
  </div>
</ResponsiveContainer>
