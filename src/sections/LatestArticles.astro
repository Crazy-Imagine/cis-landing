---
import CarouselSection from './CarouselSection.astro';
import CardCTA from '@/components/CardCTA.astro';
import Typography from '@/components/Typography.astro';
import fetchApi from '@/lib/strapi';
import type { ArticleCollection } from '@/types/strapi/Article';
import { getLangFromUrl, useTranslatedPath, useTranslations } from '@/i18n/utils';

interface Props {
  title: string;
  limit?: number;
  start?: number;
}

const articles = await fetchApi<ArticleCollection>({
  endpoint: 'articles',
  params: {
    locale: Astro.currentLocale,
    fields: ['title', 'description', 'content', 'slug'],
    publicationState: 'live',
    populate: {
      category: {
        fields: ['name'],
      },
      author: {
        fields: ['name'],
      },
      image: {
        fields: ['url', 'width', 'height', 'formats'],
      },
    },
    filters: {
      title: {
        $notNull: true,
      },
    },
    pagination: {
      start: Astro.props.start ?? 0,
      limit: Astro.props.limit ?? 8,
    },
    sort: {
      createdAt: 'desc',
    },
  },
});

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const t = useTranslations(lang);
---

<CarouselSection
  background="blueNew"
  textClass="text-white lg:w-[65%] !text-left"
  title={Astro.props.title}
>
  <Fragment slot="items">
    {
      articles.data.map(({ attributes: article }) => (
        <article class="latest-article-card swiper-slide !flex !h-auto flex-col justify-between gap-5 rounded-xl p-5">
          <Typography class="text-white" as="p" variant="accent">
            {article.title}
          </Typography>

          <CardCTA
            isNew
            gradient="text-[#B1D600]"
            align="left"
            class="!justify-self-start"
            href={translatePath(`/blog/${article.slug}`, lang)}
            text={t('common.read-more')}
            ariaLabel={`${t('aria.link-to-blog-post')}: "${article.title}"`}
          />
        </article>
      ))
    }
  </Fragment>

  <slot name="button" />
</CarouselSection>

<style>
  .latest-article-card {
    background: rgba(226, 229, 232, 0.08);
    box-shadow: 10px 10px 100px 3px rgba(0, 0, 0, 0.06);
    backdrop-filter: blur(18.850000381469727px);
  }
</style>
