---
import NavLinks from '@/components/NavLinks.astro';
import ResponsiveContainer from '@/components/ResponsiveContainer.astro';
import SocialIcons from '@/components/SocialIcons.astro';
import { getLangFromUrl, useTranslatedPath, useTranslations } from '@/i18n/utils';
import CISLogoNew from '@/icons/CISLogoNew.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<ResponsiveContainer
  background="blueNew"
  containerClass="pb-5 md:pb-10"
  class="flex flex-col gap-10 !pb-10"
>
  <div class="flex h-max flex-col justify-between text-white md:flex-row md:flex-wrap md:gap-x-2.5">
    <div class="mb-10 md:basis-[calc(50%-10px)] xl:mb-0 xl:basis-[calc(25%-10px)]">
      <CISLogoNew class="mb-5" />
      <p
        class="mb-2.5 mt-5 flex items-center gap-2 font-roboto text-xs leading-6 tracking-wide text-white"
      >
        {t('footer.all-rights-reserved')}
      </p>
    </div>

    <div class="flex basis-[calc(50%-10px)] flex-col justify-between gap-10 lg:flex-row">
      <div class="md:basis-[calc(50%-10px)] xl:basis-[calc(20%-10px)]">
        <NavLinks class="!flex flex-col !items-start justify-start text-left" />
      </div>

      <div
        class="mb-10 flex flex-col gap-5 md:mb-0 md:basis-[calc(50%-10px)] xl:basis-[calc(25%-10px)]"
      >
        <p class="font-nexaBold text-lg uppercase leading-7 tracking-wider text-white">
          {t('common.follow-us')}
        </p>

        <SocialIcons isNew class="!flex !gap-3" />
      </div>
    </div>

