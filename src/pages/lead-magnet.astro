---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import LandingCard from '@/components/LandingCard.astro';
import Quote from '@/components/Quote.astro';
import ResponsiveContainer from '@/components/ResponsiveContainer.astro';
import Typography from '@/components/Typography.astro';
import { OUR_PROCESS_LEAD_MAGNET, THE_CLARITY_YOU_NEED } from '@/consts/data';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import Layout from '@/layouts/Layout.astro';
import HeroNew from '@/sections/HeroNew.astro';
import LandingFormSection from '@/sections/LandingFormSection.astro';

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/landing/*.webp');

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const SEO = {
  metaTitle: 'Lead Magnet',
  metaDescription: 'Lead Magnet',
};
---

<Layout isNew seo={SEO}>
  <HeroNew title={t('lead-magnet.hero-title')} subtitle={t('lead-magnet.hero-subtitle')}>
    <Typography as="p" variant="paragraph" class="max-w-[600px] text-white">
      {t('lead-magnet.hero-description')}
    </Typography>
  </HeroNew>

  <LandingFormSection title={t('common.contact-us')} formId="263529">
    <Image
      class="mx-auto hidden w-full max-w-[420px] lg:block"
      src={images['/src/assets/landing/lead-magnet-book.webp']()}
      alt=""
      width={500}
      height={500}
    />
  </LandingFormSection>

  <ResponsiveContainer background="blueNew">
    <Typography as="h2" variant="h3" class="mb-10 max-w-[800px] font-bold text-white">
      {t('lead-magnet.questions-title')}
    </Typography>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {
        OUR_PROCESS_LEAD_MAGNET(lang).map((item) => (
          <LandingCard tone="dark" title={item.title} content={item.content} icon={item.image} />
        ))
      }
    </div>
  </ResponsiveContainer>

  <ResponsiveContainer background="white">
    <div class="mx-auto flex max-w-[900px] flex-col gap-4 text-center">
      <Typography as="h2" variant="h3" class="font-bold text-primary-blue">
        {t('lead-magnet.not-your-fault-title')}
      </Typography>
      <Typography as="p" variant="paragraph" class="text-primary-blue">
        {t('lead-magnet.not-your-fault-description')}
      </Typography>
    </div>
  </ResponsiveContainer>

  <ResponsiveContainer background="gray">
    <div class="mb-10 flex max-w-[900px] flex-col gap-5">
      <Typography as="h2" variant="h3" class="font-bold text-primary-blue">
        {t('lead-magnet.the-clarity-you-need-title-1')}
        {t('lead-magnet.the-clarity-you-need-title-2')}
      </Typography>
      <Typography as="p" variant="paragraph" class="text-primary-blue">
        {t('lead-magnet.the-clarity-you-need-description')}
      </Typography>
      <Typography as="p" variant="paragraph" class="font-bold text-primary-blue">
        {t('lead-magnet.the-clarity-you-need-caption')}
      </Typography>
    </div>
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
      {
        THE_CLARITY_YOU_NEED(lang).map((item) => (
          <LandingCard
            title={item.title}
            content={item.content}
            icon={item.image}
            class="!bg-white"
          />
        ))
      }
    </div>
  </ResponsiveContainer>

  <ResponsiveContainer background="blueNew">
    <div class="mx-auto mb-12 flex max-w-[900px] flex-col gap-5 text-center">
      <Typography as="h2" variant="h3" class="font-bold text-white">
        {t('lead-magnet.clientify-title-1')}
        {t('lead-magnet.clientify-title-2')}
      </Typography>
      <Typography as="p" variant="paragraph" class="text-white">
        {t('lead-magnet.clientify-description-1')}
      </Typography>
    </div>
    <Quote
      quote={t('lead-magnet.clientify-quote')}
      author={t('lead-magnet.clientify-quote-author')}
    />
  </ResponsiveContainer>

  <ResponsiveContainer background="gray">
    <div class="mx-auto flex max-w-[900px] flex-col gap-5 text-center">
      <Typography as="h2" variant="h3" class="font-bold text-primary-blue">
        {t('lead-magnet.roadmap-title-1')}
        {t('lead-magnet.roadmap-title-2')}
      </Typography>
      <Typography as="p" variant="paragraph" class="text-primary-blue">
        {t('lead-magnet.roadmap-description')}
      </Typography>
    </div>
  </ResponsiveContainer>

  <LandingFormSection
    title={t('common.contact-us')}
    description={t('lead-magnet.contact-us-description')}
    formId="263529"
  >
    <Image
      class="mx-auto hidden w-full max-w-[420px] lg:block"
      src={images['/src/assets/landing/lead-magnet-book.webp']()}
      alt=""
      width={500}
      height={500}
    />
  </LandingFormSection>
</Layout>
