---
import Hero from '@/sections/Hero.astro';
import Layout from '@/layouts/Layout.astro';
import fetchApi from '@/lib/strapi';
import type { ServiceAttributes, ServiceCollection } from '@/types/strapi/Service';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import ServiceMainContent from '@/sections/Services/ServiceMainContent.astro';
import ServicesFeatures from '@/sections/Services/ServicesFeatures.astro';
import ServicesCTA from '@/components/Services/ServicesCTA.astro';

export async function getStaticPaths() {
  const serviceCollection = await fetchApi<ServiceCollection>({
    endpoint: 'services',
    params: {
      locale: 'en',
      fields: ['title', 'subTitle', 'description', 'slug', 'key'],
      populate: {
        seo: true,
        pricing: true,
        hero: {
          fields: true,
          populate: {
            image: {
              fields: ['url', 'width', 'height', 'alternativeText'],
            },
          },
        },
        mainContent: {
          fields: ['title', 'description', 'image', 'caption'],
          populate: {
            image: {
              fields: ['url', 'width', 'height', 'alternativeText'],
            },
          },
        },
        features: {
          fields: ['title', 'subtitle', 'icon'],
          populate: {
            feats: {
              fields: ['title', 'content'],
              populate: {
                icon: {
                  fields: ['url', 'width', 'height', 'alternativeText'],
                },
              },
            },
          },
        },
        cta: true,
      },
      sort: {
        createdAt: 'asc',
      },
    },
  });

  const esServiceCollection = await fetchApi<ServiceCollection>({
    endpoint: 'services',
    params: {
      locale: 'es',
      fields: ['slug', 'key'],
      publicationState: 'live',
      sort: {
        createdAt: 'desc',
      },
    },
  });

  return serviceCollection.data.map(({ attributes, id }) => ({
    params: { slug: attributes.slug },
    props: {
      id,
      attributes,
      hrefLangSlug: esServiceCollection.data.find(
        (project) => project.attributes.key === attributes.key
      )?.attributes.slug,
    },
  }));
}

interface Props {
  id: number;
  attributes: ServiceAttributes;
  hrefLangSlug: string;
}

const { attributes, hrefLangSlug } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout
  isNew
  seo={attributes.seo}
  image={attributes.hero.image?.data?.attributes?.url ??
    attributes.hero.backgroundImage?.data?.attributes?.url}
  hrefLangPathname={`/services/${hrefLangSlug}`}
>
  <Hero
    isNew
    isCustom
    hiddenClutch
    sectionClass="sm:!h-[680px] xl:!h-[650px]"
    {...attributes.hero}
  />

  <ServiceMainContent {...attributes} />

  <ServicesFeatures {...attributes.features} />

  <ServicesCTA {...attributes.cta} />
</Layout>
