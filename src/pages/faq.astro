---
import FAQSection from '@/sections/FAQSection.astro';
import HeroNew from '@/sections/HeroNew.astro';
import CTOManual from '@/components/CTOManual.astro';
import Layout from '@/layouts/Layout.astro';
import fetchApi from '@/lib/strapi';
import type { FAQ } from '@/types/strapi/pages/FAQ';

const faqPage = await fetchApi<FAQ>({
  endpoint: 'faq-page',
  params: {
    locale: Astro.currentLocale,
    populate: {
      seo: true,
      hero: {
        fields: true,
        populate: {
          image: {
            fields: ['url', 'width', 'height', 'formats', 'alternativeText'],
          },
        },
      },
    },
  },
});
---

<Layout isNew seo={faqPage.data.attributes.seo}>
  <HeroNew {...faqPage.data.attributes.hero} />

  <FAQSection />

  <CTOManual />
</Layout>
