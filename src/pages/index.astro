---
import Hero from '@/sections/Hero.astro';
import Layout from '@/layouts/Layout.astro';
import LinkPill from '@/components/LinkPill.astro';
import Partners from '@/sections/Partners.astro';
import fetchApi from '@/lib/strapi';
import type { PageInfo } from '@/types/strapi/PageInfo';
import { getLangFromUrl, useTranslatedPath, useTranslations } from '@/i18n/utils';
import LatestProjectsNew from '@/sections/LatestProjectsNew.astro';
import ServicesNew from '@/components/ServicesNew.astro';
import ReachOut from '@/sections/ReachOut.astro';

const pageInfo = await fetchApi<PageInfo>({
  endpoint: 'home-page',
  params: {
    locale: Astro.currentLocale,
    populate: {
      seo: true,
      hero: {
        fields: true,
        populate: {
          image: {
            fields: ['url', 'width', 'height', 'formats', 'alternativeText'],
          },
        },
      },
    },
  },
});

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const translatePath = useTranslatedPath(lang);
---

<Layout isNew seo={pageInfo.data.attributes.seo} canonical="https://crazyimagine.com/es">
  <Hero {...pageInfo.data.attributes.hero} isNew customHeight="sm:h-[680px] xl:h-[780px]">
    <LinkPill isNew slot="button" variant="contained" href={translatePath('/contact-us', lang)}>
      {t('common.home-hero-button')}
    </LinkPill>
  </Hero>

  <Partners isNew title={t('common.partners-title')} />

  <LatestProjectsNew title={t('common.latest-projects-title')} />

  <ServicesNew />

  <ReachOut
    background="blueNew"
    embedRootId="contact-page-reach-out"
    title={t('common.reach-out-title')}
    subtitle={t('common.reach-out-subtitle')}
  />
</Layout>
