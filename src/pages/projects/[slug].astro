---
import LatestProjects from '@/sections/LatestProjects.astro';
import Layout from '@/layouts/Layout.astro';
import fetchApi from '@/lib/strapi';
import type { ProjectAttributes, ProjectCollection } from '@/types/strapi/Project';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import Hero from '@/sections/Hero.astro';
import ChallengeSolution from '@/components/ChallengeSolution.astro';
import Features from '@/components/Features.astro';
import Typography from '@/components/Typography.astro';
import CTASection from '@/components/CTASection.astro';

export async function getStaticPaths() {
  const projectCollection = await fetchApi<ProjectCollection>({
    endpoint: 'projects',
    params: {
      locale: 'en',
      fields: ['title', 'description', 'details', 'slug', 'Key', 'challenge', 'solution'],
      publicationState: 'live',
      populate: {
        hero: {
          fields: true,
          populate: {
            image: {
              fields: ['url', 'width', 'height', 'formats', 'alternativeText'],
            },
          },
        },
        feats: {
          fields: ['title', 'content', 'icon'],
          populate: {
            icon: {
              fields: ['url', 'width', 'height', 'alternativeText'],
            },
          },
        },
        cta: true,
        // TODO: add seo after seo tags are added on production
        // seo: true,
        project_types: {
          fields: ['name', 'slug'],
        },
        images: {
          fields: ['url', 'formats', 'width', 'height'],
        },
        galleryImages: {
          fields: ['url', 'formats', 'width', 'height'],
        },
      },
      filters: {
        title: {
          $notNull: true,
        },
      },
      sort: {
        createdAt: 'desc',
      },
    },
  });

  const esProjectCollection = await fetchApi<ProjectCollection>({
    endpoint: 'projects',
    params: {
      locale: 'es',
      fields: ['slug', 'Key'],
      publicationState: 'live',
      sort: {
        createdAt: 'desc',
      },
    },
  });

  return projectCollection.data.map(({ attributes, id }) => ({
    params: { slug: attributes.slug },
    props: {
      id,
      attributes,
      hrefLangSlug: esProjectCollection.data.find(
        (project) => project.attributes.Key === attributes.Key
      )?.attributes.slug,
    },
  }));
}

interface Props {
  id: number;
  attributes: ProjectAttributes;
  hrefLangSlug?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { attributes, id, hrefLangSlug } = Astro.props as Props;

const {
  images: {
    data: [image], // TODO: Image must return alt text
  },
  ...project
} = attributes;

console.log(project);
---

<Layout
  isNew
  seo={{
    metaTitle: project.title,
    metaDescription: project.description,
  }}
  image={image.attributes.formats.small.url}
  hrefLangPathname={hrefLangSlug ? `/es/projects/${hrefLangSlug}` : undefined}
>
  <Hero
    isNew
    hiddenClutch
    isCustom
    sectionClass="sm:!h-[680px] xl:!h-[650px]"
    {...project.hero}
    types={project.project_types.data.map((type) => type.attributes.name)}
    title={`${project.title} \n ${project.hero.title}`}
    customImageClass="!right-0"
  />
  <ChallengeSolution solution={project.solution} challenge={project.challenge} />
  <Features feats={project.feats} />

  <LatestProjects
    isNew
    title={t('common.other-projects-title')}
    subtitle={t('common.other-projects-description')}
    background="white"
    hideAllProjects
    projectId={id}
    categoryId={attributes.project_types.data[0].id}
  >
    <a
      slot="custom-all-button"
      href="/es/projects"
      class="absolute right-0 top-[30%] z-10 text-primary-blue"
    >
      <Typography isNew as="span" variant="p" class="font-bold text-primary-blue">
        {t('common.explore-other-projects')}</Typography
      >
    </a>
  </LatestProjects>

  <CTASection
    title={project.cta.title}
    caption={project.cta.caption}
    subtitle={project.cta.subtitle}
    href="/es/projects"
    buttonText={t('common.home-hero-button')}
  />
</Layout>
