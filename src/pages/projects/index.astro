---
import HeroNew from '@/sections/HeroNew.astro';
import Layout from '@/layouts/Layout.astro';
import ProjectsList from '@/sections/Projects/ProjectsList.astro';
import fetchApi from '@/lib/strapi';
import type { ProjectsPage } from '@/types/strapi/pages/Project';
import Reviews from '@/sections/Reviews.astro';

const projectsPage = await fetchApi<ProjectsPage>({
  endpoint: 'projectspage',
  params: {
    locale: Astro.currentLocale,
    populate: {
      seo: true,
      hero: {
        populate: {
          image: {
            fields: ['url', 'width', 'height', 'formats', 'alternativeText'],
          },
        },
      },
    },
  },
});
---

<Layout isNew seo={projectsPage.data.attributes.seo}>
  <HeroNew {...projectsPage.data.attributes.hero} />

  <ProjectsList />

  <Reviews isNew background="blueNew" />
</Layout>
