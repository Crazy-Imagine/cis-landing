---
import LinkPill from '@/components/LinkPill.astro';
import Typography from '@/components/Typography.astro';
import Layout from '@/layouts/Layout.astro';
---

<Layout
  isNew
  seo={{
    metaTitle: 'Gracias por contactarnos',
    metaDescription: 'Gracias por contactarnos',
  }}
  hiddenFooter
>
  <section
    class="-mt-[var(--header-height)] flex min-h-screen items-center justify-center bg-primary-blue bg-hero-background bg-left-top bg-no-repeat px-4 pt-[var(--header-height)] text-center"
  >
    <div class="flex max-w-[800px] flex-col items-center gap-6 py-20">
      <Typography as="h1" variant="h1" class="font-bold text-white">
        ¡Gracias por **contactarnos**!
      </Typography>
      <Typography as="p" variant="paragraph" class="text-white">
        Tu mensaje ha sido recibido con éxito y nuestro equipo ya está revisando la información que
        nos proporcionaste.
      </Typography>
      <Typography as="p" variant="paragraph" class="text-white">
        ¡Estamos emocionados de colaborar contigo y llevar tus ideas al siguiente nivel!
      </Typography>
      <LinkPill
        isNew
        variant="contained"
        href="https://crazyimagine.com/"
        target="_blank"
        rel="noopener"
        class="mt-4 !rounded-md !px-8 !py-4 text-lg !normal-case !tracking-normal"
      >
        Ir al sitio web
      </LinkPill>
    </div>
  </section>
</Layout>
