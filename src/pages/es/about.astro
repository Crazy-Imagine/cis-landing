---
import Layout from '@/layouts/Layout.astro';
import CTOManual from '@/components/CTOManual.astro';
import fetchApi from '@/lib/strapi';
import MissionVision from '@/sections/About/MissionVision.astro';
import Values from '@/sections/About/Values.astro';
import HeroNew from '@/sections/HeroNew.astro';
import TheTeam from '@/sections/TheTeam.astro';
import type { PageInfo } from '@/types/strapi/PageInfo';

const pageInfo = await fetchApi<PageInfo>({
  endpoint: 'about-page',
  params: {
    locale: Astro.currentLocale,
    populate: {
      seo: true,
      values: true,
      hero: {
        fields: true,
        populate: {
          image: {
            fields: ['url', 'width', 'height', 'formats', 'alternativeText'],
          },
        },
      },
      missionVission: {
        fields: true,
        populate: {
          image: {
            fields: ['url', 'width', 'height', 'formats', 'alternativeText'],
          },
        },
      },
    },
  },
});
---

<Layout isNew seo={pageInfo.data.attributes.seo}>
  <HeroNew {...pageInfo.data.attributes.hero} />

  {
    pageInfo.data.attributes.missionVission && (
      <MissionVision missionVission={pageInfo.data.attributes.missionVission} />
    )
  }

  {
    pageInfo.data.attributes.values?.length > 0 && (
      <Values values={pageInfo.data.attributes.values} />
    )
  }

  <TheTeam />

  <CTOManual />
</Layout>
