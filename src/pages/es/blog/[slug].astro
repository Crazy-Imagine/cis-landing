---
import { Image } from 'astro:assets';
import BlogContent from '@/sections/Blog/Content.astro';
import LatestArticles from '@/sections/LatestArticles.astro';
import Layout from '@/layouts/Layout.astro';
import ResponsiveContainer from '@/components/ResponsiveContainer.astro';
import fetchApi from '@/lib/strapi';
import type { ArticleAttributes, ArticleCollection } from '@/types/strapi/Article';
import { getImageUrl } from '@/utils/imageUrl';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import HeroNew from '@/sections/HeroNew.astro';
import { stripHighlight } from '@/utils/highlight';
import Typography from '@/components/Typography.astro';
import CTASection from '@/components/CTASection.astro';

export async function getStaticPaths() {
  const articleCollection = await fetchApi<ArticleCollection>({
    endpoint: 'articles',
    params: {
      locale: 'es',
      fields: ['title', 'description', 'content', 'slug', 'Key'],
      publicationState: 'live',
      populate: {
        // TODO: add seo after seo tags are added on production
        // seo: true,
        Button: true,
        category: {
          fields: ['name'],
        },
        author: {
          fields: ['name'],
        },
        image: {
          fields: ['url', 'width', 'height', 'formats', 'alternativeText'],
        },
        contentImage: {
          fields: ['url', 'width', 'height', 'formats', 'alternativeText'],
        },
        lastImageArticle: {
          fields: ['url', 'width', 'height', 'formats', 'alternativeText'],
        },
      },
      sort: {
        createdAt: 'desc',
      },
    },
  });

  const enArticleCollection = await fetchApi<ArticleCollection>({
    endpoint: 'articles',
    params: {
      locale: 'en',
      fields: ['slug', 'Key'],
      publicationState: 'live',
      sort: {
        createdAt: 'desc',
      },
    },
  });

  return articleCollection.data.map(({ attributes, id }) => ({
    params: { slug: attributes.slug },
    props: {
      id,
      attributes,
      hrefLangSlug: enArticleCollection.data.find(
        (article) => article.attributes.Key === attributes.Key
      )?.attributes.slug,
    },
  }));
}

interface Props {
  id: number;
  attributes: ArticleAttributes;
  hrefLangSlug: string;
}

const { attributes, id, hrefLangSlug } = Astro.props as Props;

const { contentImage, image, Button, lastImageArticle, ...article } = attributes;
const imageToRender = contentImage.data ?? image.data;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout
  seo={{
    metaTitle: stripHighlight(article.title),
    metaDescription: article.description,
  }}
  image={imageToRender.attributes.formats.small.url}
  hrefLangPathname={`/blog/${hrefLangSlug}`}
  isNew
>
  <HeroNew title={article.title} tags={[article.category.data.attributes.name]} />
  <!-- <BlogTitle
    author={article.author.data.attributes.name}
    category={article.category.data.attributes.name}
    description={article.description}
    title={article.title}
  /> -->

  <ResponsiveContainer background="gray" containerClass="!pb-0 !pt-10">
    <Typography class="mb-10 border-l border-l-black pl-5" variant="accent" as="p"
      >{article.author.data.attributes.name}</Typography
    >
    <Image
      transition:name={`${article.title}-image`}
      src={getImageUrl(imageToRender.attributes.url)}
      alt={imageToRender.attributes.alternativeText ?? stripHighlight(article.title)}
      width={imageToRender.attributes.width}
      height={imageToRender.attributes.height}
      class="mx-auto w-full rounded-sm grayscale"
    />
  </ResponsiveContainer>

  <BlogContent id={id} content={article.content} button={Button} />

  {
    lastImageArticle?.data && (
      <ResponsiveContainer containerClass="!pt-0">
        <Image
          transition:name={`${article.title}-image`}
          src={getImageUrl(lastImageArticle.data.attributes.url)}
          alt={lastImageArticle.data.attributes.alternativeText ?? stripHighlight(article.title)}
          width={lastImageArticle.data.attributes.width}
          height={lastImageArticle.data.attributes.height}
          class="mx-auto grayscale"
        />
      </ResponsiveContainer>
    )
  }

  <CTASection
    title={t('common.blog-cta-title')}
    subtitle={t('common.blog-cta-subtitle')}
    href="/es/contact-us"
    buttonText={t('common.blog-cta-button')}
    isCard
  />

  <LatestArticles start={2} title={t('common.other-articles-you-might-like')} />
</Layout>
