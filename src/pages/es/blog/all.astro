---
import Layout from '@/layouts/Layout.astro';
import CTOManual from '@/components/CTOManual.astro';
import fetchApi from '@/lib/strapi';
import ArticlesGrid from '@/sections/Blog/ArticlesGrid.astro';
import HeroNew from '@/sections/HeroNew.astro';
import type { PageInfo } from '@/types/strapi/PageInfo';

// Resultados del buscador del blog: se renderiza en cada request para leer `?search=`.
export const prerender = false;

const search = Astro.url.searchParams.get('search') || '';

const pageInfo = await fetchApi<PageInfo>({
  endpoint: 'blog',
  params: {
    locale: Astro.currentLocale,
    populate: {
      seo: true,
      hero: {
        populate: {
          image: {
            fields: ['url', 'width', 'height', 'formats', 'alternativeText'],
          },
        },
      },
    },
  },
});
---

<Layout isNew seo={pageInfo.data.attributes.seo}>
  <HeroNew {...pageInfo.data.attributes.hero} align="center" />

  <ArticlesGrid search={search} />

  <CTOManual />
</Layout>
