---
import CheckList from '@/components/CheckList.astro';
import LandingCard from '@/components/LandingCard.astro';
import LinkPill from '@/components/LinkPill.astro';
import Quote from '@/components/Quote.astro';
import ResponsiveContainer from '@/components/ResponsiveContainer.astro';
import Typography from '@/components/Typography.astro';
import { EXECUTION_SPEED, OUR_PROCESS_IA } from '@/consts/data';
import { getLangFromUrl } from '@/i18n/utils';
import Layout from '@/layouts/Layout.astro';
import HeroNew from '@/sections/HeroNew.astro';
import Partners from '@/sections/Partners.astro';

const SEO = {
  metaTitle: 'Agentes IA',
  metaDescription: 'Agentes IA',
  keywords: 'Agentes IA',
};

const QUOTE_FORM_URL =
  'https://docs.google.com/forms/d/e/1FAIpQLSf7V6WyuKBgrEIZfeOPQ-miQCpTInLGljHJb-28Tl6F_NR1aA/viewform';

const lang = getLangFromUrl(Astro.url);
---

<Layout isNew seo={SEO}>
  <HeroNew
    title="El Fin del **Gasto Silencioso**"
    subtitle="Tu Empresa Necesita un Empleado Digital 24/7"
    cta={{ text: 'Solicitar mi cotización', href: '#cotizacion' }}
  >
    <Typography as="p" variant="paragraph2" class="max-w-[600px] text-white">
      No son chatbots. Son Agentes de IA que entienden, razonan y ejecutan tareas, liberando a tu
      equipo para la innovación y ahorrándote hasta el 40% de tus costos operativos.
    </Typography>
  </HeroNew>

  <Partners isNew title="Socios Tecnológicos de Empresas que Lideran el Mercado" />

  <ResponsiveContainer background="blueNew">
    <div class="mb-10 flex max-w-[900px] flex-col gap-4">
      <Typography as="h2" variant="h3" class="font-bold text-white">
        Tu Mayor Competidor No es la Competencia, Es la **Lentitud Interna**.
      </Typography>
      <Typography as="p" variant="paragraph" class="font-bold text-white">
        El Costo de la Operación Manual:
      </Typography>
    </div>
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
      {
        OUR_PROCESS_IA(lang).map((item) => (
          <LandingCard tone="dark" title={item.title} content={item.content} icon={item.image} />
        ))
      }
    </div>
    <Typography as="p" variant="h4" class="mt-12 text-center font-bold text-white">
      ¿Tu talento senior está innovando, o está atrapado en la burocracia digital?
    </Typography>
  </ResponsiveContainer>

  <ResponsiveContainer background="white">
    <Typography as="h2" variant="h3" class="mb-10 max-w-[900px] font-bold text-primary-blue">
      Velocidad de Ejecución Garantizada: La Única Forma de Liderar
    </Typography>
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
      {
        EXECUTION_SPEED(lang).map((item) => (
          <LandingCard title={item.title} content={item.content} />
        ))
      }
    </div>
  </ResponsiveContainer>

  <ResponsiveContainer background="blueNew">
    <div class="mx-auto mb-12 flex max-w-[900px] flex-col gap-5 text-center">
      <Typography as="h2" variant="h3" class="font-bold text-white">
        Transformamos el Riesgo en **Retorno de Inversión (ROI)**.
      </Typography>
      <Typography as="p" variant="paragraph" class="text-white">
        Somos una Software Factory experta. No vendemos bots; construimos soluciones robustas y
        escalables. Nuestro proceso de vetting de IA garantiza que tu agente entiende, razona y
        ejecuta tareas críticas sin errores.
      </Typography>
    </div>
    <Quote
      quote="No alquilamos bots. Construimos soluciones que se integran a tu negocio y garantizan un impacto financiero. Ese es nuestro único KPI."
      author="— Blas Hernandez, CEO de Crazy Imagine Software"
    />
  </ResponsiveContainer>

  <ResponsiveContainer background="white">
    <div
      id="cotizacion"
      class="mx-auto flex max-w-[1000px] scroll-mt-[var(--header-height)] flex-col gap-6 rounded-md bg-gray-new p-8 shadow-md lg:p-14"
    >
      <Typography as="h2" variant="h3" class="font-bold text-primary-blue">
        Solicita tu Diagnóstico de Automatización. Acelera tu implementación tecnológica.
      </Typography>
      <Typography as="p" variant="paragraph" class="text-primary-blue">
        Completa el formulario para recibir una cotización detallada y personalizada, directo en tu
        correo.
      </Typography>
      <Typography as="p" variant="paragraph" class="font-bold text-primary-blue">
        En tu propuesta recibirás:
      </Typography>
      <CheckList
        items={[
          'Estimación de inversión transparente: Sin sorpresas ni costos ocultos.',
          'Tiempos de implementación: Cronograma real de puesta en marcha.',
          'Alcance técnico preliminar: Qué incluye exactamente tu solución.',
        ]}
      />
      <LinkPill
        isNew
        variant="contained"
        href={QUOTE_FORM_URL}
        target="_blank"
        rel="noopener"
        class="mt-4 self-start !rounded-md !px-8 !py-4 text-lg !normal-case !tracking-normal"
      >
        Solicitar mi cotización
      </LinkPill>
    </div>
  </ResponsiveContainer>
</Layout>
