---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import CheckList from '@/components/CheckList.astro';
import LandingCard from '@/components/LandingCard.astro';
import LinkPill from '@/components/LinkPill.astro';
import ResponsiveContainer from '@/components/ResponsiveContainer.astro';
import Typography from '@/components/Typography.astro';
import Layout from '@/layouts/Layout.astro';
import HeroNew from '@/sections/HeroNew.astro';
import LandingFormSection from '@/sections/LandingFormSection.astro';
import Partners from '@/sections/Partners.astro';

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/landing/*.webp');

const SEO = {
  metaTitle: 'Agendamiento',
  metaDescription: 'Agendamiento',
};

const SOLUTIONS = [
  {
    title: 'Para la falta de equipo',
    content:
      'Staff Augmentation. Integramos talento senior verificado en tu proyecto en cuestión de días.',
  },
  {
    title: 'Para la falta de tiempo',
    content:
      'Outsourcing de Proyectos. Nos encargamos del desarrollo de principio a fin, para que tú te enfoques en tu negocio.',
  },
  {
    title: 'Para una necesidad única',
    content:
      'Software Personalizado. Creamos la herramienta a medida que te dará una ventaja competitiva real.',
  },
  {
    title: 'Para garantizar la operatividad',
    content: 'Mantenimiento Web. Tu garantía de que todo funcione sin fallos, siempre.',
  },
];
---

<Layout isNew seo={SEO}>
  <HeroNew
    showClutch
    title="¿Tienes la idea? El verdadero reto es **construirla**"
    subtitle="Accede al pool de talento tecnológico más exclusivo de Latinoamérica (Top 5%) y ten a un desarrollador de élite integrado en tu equipo en semanas, no meses."
    cta={{ text: 'Evalúa tu equipo ahora', href: '#contact' }}
  />

  <ResponsiveContainer background="gray">
    <div
      class="mx-auto mb-12 aspect-video w-full max-w-[900px] overflow-hidden rounded-md shadow-md"
    >
      <iframe
        class="h-full w-full"
        src="https://www.youtube.com/embed/u8geER7dVK8?si=IoFU9DbaJEKzfH7F&autoplay=1&mute=1&loop=1&playlist=u8geER7dVK8"
        title="YouTube video player"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen></iframe>
    </div>

    <div class="flex flex-col gap-10 rounded-md bg-white p-8 shadow-md lg:flex-row lg:p-12">
      <div class="flex w-full flex-col gap-5 lg:w-1/2">
        <Typography as="h2" variant="h3" class="font-bold text-primary-blue">
          Agenda una cita
        </Typography>
        <Typography as="p" variant="paragraph" class="font-bold text-primary-blue">
          ¿Preparado para el siguiente nivel?
        </Typography>
        <Typography as="p" variant="paragraph2" class="text-primary-blue">
          ¿Buscas la mejor solución de software para tu empresa? Te ofrecemos una cita informativa
          de <strong>30 minutos</strong> para conocer tus necesidades y presentarte las mejores opciones
          tecnológicas adaptadas a tu negocio.
        </Typography>
        <Typography as="p" variant="paragraph2" class="text-primary-blue">
          <strong>¡Es totalmente gratuita!</strong> Solo elige el día y la hora que más te convenga.
        </Typography>
      </div>
      <div class="w-full lg:w-1/2">
        <iframe
          title="Agenda una cita"
          src="https://calendar.google.com/calendar/appointments/schedules/AcZssZ3xIBRNKUddB3R-8iP-ygg2r6SHiyfxBvpM7g_u1SEhM-d6pVv0RO-5szyvHelDlPQRBHjf0yqv?gv=true"
          style="border: 0"
          width="100%"
          height="550"
          frameborder="0"></iframe>
      </div>
    </div>
  </ResponsiveContainer>

  <Partners isNew title="Socios Tecnológicos de Empresas que Lideran el Mercado" />

  <ResponsiveContainer background="gray">
    <div class="mx-auto flex max-w-[900px] flex-col gap-8">
      <Typography as="h2" variant="h3" class="font-bold text-primary-blue">
        Si te identificas con esto, estás en el lugar correcto
      </Typography>
      <CheckList
        items={[
          'Frenados por la falta de talento técnico para avanzar.',
          'Ciclos de contratación que se extienden por más de 3 meses.',
          'Luchando con tecnología que no da la talla y se convierte en un freno.',
        ]}
      />
    </div>
  </ResponsiveContainer>

  <ResponsiveContainer background="blueNew" containerClass="!pb-0">
    <div class="flex flex-col items-center gap-10 lg:flex-row lg:items-end">
      <div class="flex w-full flex-col gap-6 pb-10 lg:w-3/5 lg:pb-20">
        <Typography as="h2" variant="h3" class="font-bold text-white">
          No Somos una Agencia. Somos **tu Socio de Ejecución**.
        </Typography>
        <figure class="flex flex-col gap-4">
          <blockquote>
            <Typography as="p" variant="paragraph" class="text-white">
              "Desde hace más de 8 años, mi único foco ha sido construir el socio tecnológico que yo
              mismo hubiese querido tener: uno que entiende de negocio, se obsesiona con los
              resultados y te da la tranquilidad para enfocarte en crecer."
            </Typography>
          </blockquote>
          <figcaption>
            <Typography as="p" variant="paragraph2" class="font-bold text-primary-new">
              — Blas Hernandez, CEO & Fundador
            </Typography>
          </figcaption>
        </figure>
      </div>
      <Image
        class="w-full max-w-[380px] lg:w-2/5"
        src={images['/src/assets/landing/blas-hernandez-2.webp']()}
        alt="Blas Hernandez, CEO & Fundador de Crazy Imagine"
      />
    </div>
  </ResponsiveContainer>

  <ResponsiveContainer background="white">
    <Typography as="h2" variant="h3" class="mb-10 font-bold text-primary-blue">
      Para Cada Reto, una Solución Clara
    </Typography>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {
        SOLUTIONS.map((solution) => (
          <LandingCard title={solution.title} content={solution.content} />
        ))
      }
    </div>
  </ResponsiveContainer>

  <ResponsiveContainer background="blueNew">
    <div class="mx-auto flex max-w-[800px] flex-col items-center gap-6 text-center">
      <Typography as="h2" variant="h3" class="font-bold text-white">
        El costo de esperar es mayor que **el costo de actuar**
      </Typography>
      <Typography as="p" variant="paragraph" class="text-white">
        Cada día que tu proyecto se retrasa por falta de talento, tu competencia avanza. La decisión
        no es si necesitas un equipo más fuerte, sino cuándo vas a construirlo. El momento es ahora.
      </Typography>
      <LinkPill
        isNew
        variant="contained"
        href="#contact"
        class="mt-2 !rounded-md !px-8 !py-4 text-lg !normal-case !tracking-normal"
      >
        Agenda una cita
      </LinkPill>
    </div>
  </ResponsiveContainer>

  <LandingFormSection title="¡Comienza Ahora! Agenda una Cita" formId="260199" anchorId="contact">
    <CheckList
      items={[
        'Charla de 15 min, sin compromiso.',
        'Recibe un plan de acción para escalar tu equipo.',
        'Accede a talento de élite en menos de 7 días.',
      ]}
    />
  </LandingFormSection>
</Layout>
