---
import HeroNew from '@/sections/HeroNew.astro';
import Layout from '@/layouts/Layout.astro';
import fetchApi from '@/lib/strapi';
import type { ServiceAttributes, ServiceCollection } from '@/types/strapi/Service';
import ServiceMainContent from '@/sections/Services/ServiceMainContent.astro';
import ServicesFeatures from '@/sections/Services/ServicesFeatures.astro';
import ServicesCTA from '@/components/Services/ServicesCTA.astro';

export async function getStaticPaths() {
  const serviceCollection = await fetchApi<ServiceCollection>({
    endpoint: 'services',
    params: {
      locale: 'es',
      fields: ['title', 'subTitle', 'description', 'slug', 'key'],
      populate: {
        seo: true,
        cta: true,
        mainContent: {
          fields: ['title', 'description', 'caption'],
          populate: {
            image: {
              fields: ['url', 'width', 'height', 'alternativeText'],
            },
          },
        },
        features: {
          fields: ['title', 'subtitle'],
          populate: {
            feats: {
              fields: ['title', 'content'],
              populate: {
                icon: {
                  fields: ['url', 'width', 'height', 'alternativeText'],
                },
              },
            },
          },
        },
        hero: {
          populate: {
            image: {
              fields: ['url', 'width', 'height', 'alternativeText'],
            },
            backgroundImage: {
              fields: ['url', 'width', 'height', 'alternativeText'],
            },
          },
        },
      },
      sort: {
        createdAt: 'asc',
      },
    },
  });

  const enServiceCollection = await fetchApi<ServiceCollection>({
    endpoint: 'services',
    params: {
      locale: 'en',
      fields: ['slug', 'key'],
      publicationState: 'live',
      sort: {
        createdAt: 'desc',
      },
    },
  });

  return serviceCollection.data.map(({ attributes, id }) => ({
    params: { slug: attributes.slug },
    props: {
      id,
      attributes,
      hrefLangSlug: enServiceCollection.data.find(
        (project) => project.attributes.key === attributes.key
      )?.attributes.slug,
    },
  }));
}

interface Props {
  id: number;
  attributes: ServiceAttributes;
  hrefLangSlug?: string;
}

const { attributes, hrefLangSlug } = Astro.props;
---

<Layout
  isNew
  seo={attributes.seo}
  image={attributes.hero.image?.data?.attributes?.url ??
    attributes.hero.backgroundImage?.data?.attributes?.url}
  hrefLangPathname={hrefLangSlug ? `/services/${hrefLangSlug}` : undefined}
>
  <HeroNew {...attributes.hero} imageTone="mono" />

  {/* Un servicio a medio cargar en Strapi no debe romper el build: cada sección es opcional. */}
  {attributes.mainContent && <ServiceMainContent {...attributes} />}

  {attributes.features && <ServicesFeatures {...attributes.features} />}

  {attributes.cta && <ServicesCTA {...attributes.cta} />}
</Layout>
