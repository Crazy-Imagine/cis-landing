---
import Accordion from '@/components/Accordion.astro';
import CheckList from '@/components/CheckList.astro';
import LandingCard from '@/components/LandingCard.astro';
import LinkPill from '@/components/LinkPill.astro';
import ResponsiveContainer from '@/components/ResponsiveContainer.astro';
import Typography from '@/components/Typography.astro';
import {
  OUR_BENEFITS_CUSTOM_SOFTWARE_DEVELOPMENT,
  OUR_PROCESS_CUSTOM_SOFTWARE_DEVELOPMENT,
} from '@/consts/data';
import { getFeatIconColor } from '@/consts/featIconColors';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import Layout from '@/layouts/Layout.astro';
import Experience from '@/sections/Experience.astro';
import HeroNew from '@/sections/HeroNew.astro';
import LandingFormSection from '@/sections/LandingFormSection.astro';
import Partners from '@/sections/Partners.astro';
import { FAQS_ES } from '@/utils/customSoftware';

const SEO = {
  metaTitle: 'Desarrollo de Software Personalizado Crazy Imagine',
  metaDescription:
    'Crazy Imagine ofrece servicios de desarrollo de software expertos! Construimos sitios web dinámicos adaptados a sus necesidades. Obtenga diseño responsivo, front-end moderno (React, Vue.js, Angular) y desarrollo back-end seguro (Node.js, Express, Python, PHP). Optimizamos el rendimiento y integramos APIs. Contáctenos hoy!',
  keywords:
    'Servicios de desarrollo de software, Desarrollo de software personalizado, Diseño web responsivo, Desarrollo front-end (React, Vue.js, Angular), Desarrollo back-end (Node.js, Express, Python, PHP), Integración de API, Seguridad del sitio web, Desarrollo de comercio electrónico, Desarrollo de aplicaciones web',
};

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout isNew seo={SEO}>
  <HeroNew
    title={t('custom-development.hero-title')}
    subtitle={t('custom-development.hero-subtitle')}
    cta={{ text: t('common.turn-your-vision-into-a-product'), href: '#contact' }}
  />

  <Partners isNew title={t('common.technology-partners-of-market-leading-companies')} />

  <Experience />

  <ResponsiveContainer background="white">
    <div class="mx-auto flex max-w-[1000px] flex-col gap-6 text-center">
      <Typography as="h2" variant="h3" class="font-bold text-primary-blue">
        {t('custom-development.your-team')}
      </Typography>
      <Typography as="p" variant="paragraph" class="text-primary-blue">
        {t('custom-development.your-team-description')}
      </Typography>
    </div>
  </ResponsiveContainer>

  <ResponsiveContainer background="gray">
    <Typography as="h2" variant="h3" class="mb-10 font-bold text-primary-blue">
      {t('custom-development.benefits-title')}
    </Typography>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {
        OUR_BENEFITS_CUSTOM_SOFTWARE_DEVELOPMENT(lang).map((benefit) => (
          <LandingCard title={benefit.title} content={benefit.content} class="!bg-white" />
        ))
      }
    </div>
  </ResponsiveContainer>

  <ResponsiveContainer background="blueNew">
    <div class="flex flex-col items-center gap-8 text-center">
      <Typography as="h2" variant="h3" class="max-w-[800px] font-bold text-white">
        {t('custom-development.cta-title')}
      </Typography>
      <LinkPill
        isNew
        variant="contained"
        href="#contact"
        class="!rounded-md !px-8 !py-4 text-lg !normal-case !tracking-normal"
      >
        {t('custom-development.cta-button')}
      </LinkPill>
    </div>
  </ResponsiveContainer>

  <ResponsiveContainer background="white">
    <Typography as="h2" variant="h3" class="mb-10 font-bold text-primary-blue">
      {t('custom-development.our-process-title')}
    </Typography>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        OUR_PROCESS_CUSTOM_SOFTWARE_DEVELOPMENT(lang).map((step, index) => (
          <LandingCard
            label={`${t('common.phase')} ${step.id}`}
            title={step.title}
            content={step.content}
            icon={step.image}
            iconColor={getFeatIconColor(index)}
          />
        ))
      }
    </div>
  </ResponsiveContainer>

  <ResponsiveContainer background="gray">
    <div class="mx-auto flex max-w-[1000px] flex-col gap-4">
      <Typography as="h2" variant="h3" class="mb-6 font-bold text-primary-blue">
        {t('custom-development.faqs-title')}
      </Typography>
      {
        FAQS_ES.map((faq) => (
          <Accordion title={faq.title} description={faq.description} isHtml={faq.isHtml} />
        ))
      }
    </div>
  </ResponsiveContainer>

  <LandingFormSection
    title={`${t('custom-development.start-now')}: ${t('custom-development.schedule-an-appointment')}`}
    formId="259389"
    anchorId="contact"
  >
    <CheckList
      items={[
        t('custom-development.15-minute-chat-without-commitment'),
        t('custom-development.receive-an-action-plan-to-scale-your-team'),
        t('custom-development.access-elite-talent-in-less-than-7-days'),
      ]}
    />
  </LandingFormSection>
</Layout>
