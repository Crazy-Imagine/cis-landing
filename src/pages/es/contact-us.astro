---
import Hero from '@/sections/Hero.astro';
import Layout from '@/layouts/Layout.astro';
import ReachOut from '@/sections/ReachOut.astro';
import fetchApi from '@/lib/strapi';
import type { PageInfo } from '@/types/strapi/PageInfo';
import CTOManual from '@/components/CTOManual.astro';

const pageInfo = await fetchApi<PageInfo>({
  endpoint: 'contact-page',
  params: {
    locale: Astro.currentLocale,
    populate: {
      seo: true,
      hero: {
        fields: true,
        populate: {
          image: {
            fields: ['url', 'width', 'height', 'formats', 'alternativeText'],
          },
        },
      },
    },
  },
});
---

<Layout isNew seo={pageInfo.data.attributes.seo}>
  <Hero
    isNew
    isCustom
    hiddenClutch
    sectionClass="sm:!h-[680px] xl:!h-[650px]"
    {...pageInfo.data.attributes.hero}
  />

  <ReachOut embedRootId="contact-page-reach-out" />

  <CTOManual
    embedRootId="contact-page-cto-manual"
    containerClass="lg:-top-[30%] left-0 right-0"
    outerAbsoluteBounds
  />
</Layout>
