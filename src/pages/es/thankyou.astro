---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import CheckList from '@/components/CheckList.astro';
import CTASection from '@/components/CTASection.astro';
import ResponsiveContainer from '@/components/ResponsiveContainer.astro';
import Typography from '@/components/Typography.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import Layout from '@/layouts/Layout.astro';
import HeroNew from '@/sections/HeroNew.astro';

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/landing/*.webp');

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const SCHEDULE_URL = 'https://calendly.com/angel-nino-crazyimagine/diagnostico-de-roadmap-gratuito';
---

<Layout
  isNew
  seo={{
    metaTitle: 'Gracias por contactarnos',
    metaDescription: 'Gracias por contactarnos',
  }}
>
  <HeroNew title={t('thankyou.hero-title')} subtitle={t('thankyou.hero-subtitle')}>
    <Typography as="p" variant="paragraph2" class="max-w-[600px] text-white">
      {t('thankyou.hero-caption')}
    </Typography>
  </HeroNew>

  <ResponsiveContainer background="white" containerClass="!pb-0">
    <div class="flex flex-col items-center gap-10 lg:flex-row lg:items-end">
      <Image
        class="hidden w-full max-w-[320px] lg:block"
        src={images['/src/assets/landing/consuelo.webp']()}
        alt=""
      />
      <div class="flex w-full flex-col gap-5 pb-10 lg:max-w-[700px] lg:pb-20">
        <Typography as="h2" variant="h3" class="font-bold text-primary-blue">
          {t('thankyou.wait-title')}
        </Typography>
        <Typography as="p" variant="paragraph" class="font-bold text-primary-blue">
          {t('thankyou.wait-subtitle')}
        </Typography>
        <Typography as="p" variant="paragraph2" class="text-primary-blue">
          {t('thankyou.wait-caption-1')}
        </Typography>
        <Typography as="p" variant="paragraph2" class="text-primary-blue">
          {t('thankyou.wait-caption-2')}
        </Typography>
        <Typography as="p" variant="paragraph2" class="font-bold text-primary-blue">
          {t('thankyou.wait-caption-3')}
        </Typography>
      </div>
    </div>
  </ResponsiveContainer>

  <ResponsiveContainer background="blueNew">
    <div class="mx-auto flex max-w-[1000px] flex-col gap-8">
      <div class="flex flex-col gap-4 text-center">
        <Typography as="h2" variant="h3" class="font-bold text-white">
          {t('thankyou.diagnostic-title')}
        </Typography>
        <Typography as="p" variant="paragraph" class="text-white">
          {t('thankyou.diagnostic-subtitle')}
        </Typography>
      </div>

      <div
        class="flex flex-col gap-5 rounded-lg border border-[rgba(255,255,255,0.08)] bg-primary-with-transparency-white p-8 shadow-[2px_2px_0_0_rgba(172,79,198,0.45)] lg:p-10"
      >
        <Typography as="p" variant="h5" class="font-bold text-white">
          {t('thankyou.diagnostic-paragraph-1')}
        </Typography>
        <Typography as="p" variant="paragraph2" class="text-white">
          {t('thankyou.diagnostic-paragraph-2')}
        </Typography>
        <CheckList
          tone="dark"
          items={[
            t('thankyou.diagnostic-list-1'),
            t('thankyou.diagnostic-list-2'),
            t('thankyou.diagnostic-list-3'),
          ]}
        />
      </div>

      <Typography as="p" variant="h4" class="text-center font-bold text-white">
        {t('thankyou.closing')}
      </Typography>
    </div>
  </ResponsiveContainer>

  <CTASection
    isCard
    title={t('thankyou.schedule-title')}
    subtitle={t('thankyou.schedule-caption')}
    href={SCHEDULE_URL}
    buttonText={t('thankyou.schedule-button')}
  />
</Layout>
